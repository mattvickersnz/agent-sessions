#!/usr/bin/env python3
"""Resume agent sessions or park and restore a complete iTerm2 tab layout."""

from __future__ import annotations

import argparse
import curses
import datetime as dt
import json
import os
from pathlib import Path
import re
import shlex
import sqlite3
import subprocess
import sys
import tempfile
from dataclasses import dataclass, replace
from typing import Iterable


DEFAULT_DAYS = 30
DEFAULT_LIMIT = 200
MAX_CLAUDE_HEAD_BYTES = 2 * 1024 * 1024
MAX_RECENT_TAIL_BYTES = 4 * 1024 * 1024
SNAPSHOT_VERSION = 1


@dataclass(frozen=True)
class Session:
    agent: str
    session_id: str
    cwd: str
    title: str
    latest: str
    updated_ms: int
    active: bool = False

    @property
    def key(self) -> str:
        return f"{self.agent}:{self.session_id}"


def clean_text(value: object, limit: int = 140) -> str:
    if not isinstance(value, str):
        return ""
    text = value
    for tag in (
        "local-command-caveat",
        "system-reminder",
        "environment_context",
        "task-notification",
    ):
        text = re.sub(
            rf"<{tag}(?:\s[^>]*)?>.*?</{tag}>",
            " ",
            text,
            flags=re.DOTALL | re.IGNORECASE,
        )
    text = re.sub(r"</?[^>]+>", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text if len(text) <= limit else text[: limit - 1].rstrip() + "…"


def message_text(message: object) -> str:
    if not isinstance(message, dict):
        return ""
    content = message.get("content")
    if isinstance(content, str):
        return clean_text(content)
    if not isinstance(content, list):
        return ""
    parts: list[str] = []
    for item in content:
        if isinstance(item, dict) and item.get("type") in {
            "text",
            "input_text",
            "output_text",
        }:
            text = item.get("text") or item.get("input_text") or item.get("output_text")
            if isinstance(text, str):
                parts.append(text)
    return clean_text(" ".join(parts))


def reverse_json_lines(path: Path) -> Iterable[dict[str, object]]:
    """Yield recent JSONL records newest-first without reading a huge session whole."""
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            position = handle.tell()
            remaining = min(position, MAX_RECENT_TAIL_BYTES)
            partial = b""
            while remaining > 0:
                chunk_size = min(64 * 1024, remaining)
                position -= chunk_size
                handle.seek(position)
                partial = handle.read(chunk_size) + partial
                remaining -= chunk_size
                lines = partial.split(b"\n")
                partial = lines[0]
                for raw_line in reversed(lines[1:]):
                    if not raw_line:
                        continue
                    try:
                        record = json.loads(raw_line)
                    except (json.JSONDecodeError, UnicodeDecodeError):
                        continue
                    if isinstance(record, dict):
                        yield record
            if position == 0 and partial:
                try:
                    record = json.loads(partial)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    return
                if isinstance(record, dict):
                    yield record
    except OSError:
        return


def latest_claude_prompt(path: Path) -> str:
    for record in reverse_json_lines(path):
        if (
            record.get("type") == "user"
            and not record.get("isMeta")
            and isinstance(record.get("message"), dict)
        ):
            text = message_text(record.get("message"))
            if text:
                return text
    return ""


def latest_codex_prompt(path: Path) -> str:
    for record in reverse_json_lines(path):
        payload = record.get("payload")
        if (
            record.get("type") == "response_item"
            and isinstance(payload, dict)
            and payload.get("type") == "message"
            and payload.get("role") == "user"
        ):
            text = message_text(payload)
            if text:
                return text
    return ""


def read_claude_session(path: Path) -> Session | None:
    session_id = path.stem
    cwd = ""
    slug = ""
    title = ""
    is_sidechain = False
    entrypoint = ""
    bytes_read = 0

    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line_number, line in enumerate(handle):
                bytes_read += len(line.encode("utf-8", errors="ignore"))
                if line_number >= 500 or bytes_read > MAX_CLAUDE_HEAD_BYTES:
                    break
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(record, dict):
                    continue
                session_id = str(record.get("sessionId") or session_id)
                cwd = str(record.get("cwd") or cwd)
                slug = str(record.get("slug") or slug)
                is_sidechain = bool(record.get("isSidechain", is_sidechain))
                entrypoint = str(record.get("entrypoint") or entrypoint)

                if (
                    not title
                    and record.get("type") == "user"
                    and not record.get("isMeta")
                ):
                    title = message_text(record.get("message"))
                if cwd and title:
                    break
    except (OSError, UnicodeError):
        return None

    if is_sidechain or entrypoint == "sdk-cli" or not cwd or not session_id:
        return None
    if not title:
        title = slug.replace("-", " ") if slug else "Untitled session"
    return Session(
        agent="Claude",
        session_id=session_id,
        cwd=cwd,
        title=clean_text(title),
        latest=latest_claude_prompt(path) or clean_text(title),
        updated_ms=int(path.stat().st_mtime * 1000),
    )


def load_claude_sessions(since_ms: int, scan_limit: int) -> list[Session]:
    projects = Path.home() / ".claude" / "projects"
    if not projects.is_dir():
        return []

    candidates: list[tuple[float, Path]] = []
    for project_dir in projects.iterdir():
        if not project_dir.is_dir():
            continue
        for path in project_dir.glob("*.jsonl"):
            try:
                mtime = path.stat().st_mtime
            except OSError:
                continue
            if int(mtime * 1000) >= since_ms:
                candidates.append((mtime, path))

    candidates.sort(key=lambda item: item[0], reverse=True)
    sessions: list[Session] = []
    for _, path in candidates[:scan_limit]:
        session = read_claude_session(path)
        if session is not None:
            sessions.append(session)
    return sessions


def codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))).expanduser()


def load_codex_title_index(root: Path) -> dict[str, tuple[str, int]]:
    index: dict[str, tuple[str, int]] = {}
    path = root / "session_index.jsonl"
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try:
                    record = json.loads(line)
                    session_id = str(record.get("id") or "")
                    timestamp = record.get("updated_at")
                    updated_ms = iso_to_ms(timestamp) if timestamp else 0
                    if session_id:
                        index[session_id] = (
                            clean_text(record.get("thread_name")),
                            updated_ms,
                        )
                except (AttributeError, json.JSONDecodeError, TypeError, ValueError):
                    continue
    except OSError:
        pass
    return index


def iso_to_ms(value: object) -> int:
    if not isinstance(value, str):
        return 0
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        return int(parsed.timestamp() * 1000)
    except ValueError:
        return 0


def load_codex_from_database(root: Path, since_ms: int) -> list[Session]:
    database = root / "state_5.sqlite"
    if not database.is_file():
        return []

    uri = f"file:{database}?mode=ro"
    connection = sqlite3.connect(uri, uri=True, timeout=0.25)
    connection.row_factory = sqlite3.Row
    try:
        rows = connection.execute(
            """
            SELECT id, cwd, title, first_user_message, source, rollout_path,
                   updated_at, updated_at_ms, agent_nickname, agent_role, archived
              FROM threads
             WHERE archived = 0
               AND source != 'exec'
               AND source NOT LIKE '{%'
               AND agent_nickname IS NULL
               AND agent_role IS NULL
            """
        ).fetchall()
    finally:
        connection.close()

    sessions: list[Session] = []
    for row in rows:
        updated_ms = int(row["updated_at_ms"] or int(row["updated_at"] or 0) * 1000)
        rollout_path = Path(str(row["rollout_path"] or ""))
        try:
            updated_ms = max(updated_ms, int(rollout_path.stat().st_mtime * 1000))
        except OSError:
            pass
        if updated_ms < since_ms:
            continue
        cwd = str(row["cwd"] or "")
        session_id = str(row["id"] or "")
        if not cwd or not session_id:
            continue
        title = clean_text(row["title"] or row["first_user_message"])
        sessions.append(
            Session(
                agent="Codex",
                session_id=session_id,
                cwd=cwd,
                title=title or "Untitled session",
                latest=latest_codex_prompt(rollout_path) or title or "Untitled session",
                updated_ms=updated_ms,
            )
        )
    return sessions


def load_codex_from_rollouts(root: Path, since_ms: int) -> list[Session]:
    sessions_dir = root / "sessions"
    if not sessions_dir.is_dir():
        return []
    titles = load_codex_title_index(root)
    sessions: list[Session] = []

    for path in sessions_dir.glob("*/*/*/*.jsonl"):
        try:
            mtime_ms = int(path.stat().st_mtime * 1000)
        except OSError:
            continue
        title_entry = titles.get(path.stem.rsplit("-", 5)[-1], ("", 0))
        updated_ms = max(mtime_ms, title_entry[1])
        if updated_ms < since_ms:
            continue
        try:
            with path.open("r", encoding="utf-8", errors="replace") as handle:
                first = json.loads(handle.readline())
            if first.get("type") != "session_meta":
                continue
            payload = first.get("payload") or {}
            source = payload.get("source")
            if source == "exec" or isinstance(source, dict):
                continue
            session_id = str(payload.get("id") or "")
            cwd = str(payload.get("cwd") or "")
            if not session_id or not cwd:
                continue
            title, index_ms = titles.get(session_id, ("", 0))
            sessions.append(
                Session(
                    agent="Codex",
                    session_id=session_id,
                    cwd=cwd,
                    title=title or "Untitled session",
                    latest=latest_codex_prompt(path) or title or "Untitled session",
                    updated_ms=max(mtime_ms, index_ms),
                )
            )
        except (OSError, AttributeError, json.JSONDecodeError):
            continue
    return sessions


def load_codex_sessions(since_ms: int) -> list[Session]:
    root = codex_home()
    try:
        sessions = load_codex_from_database(root, since_ms)
        if sessions:
            return sessions
    except (OSError, sqlite3.Error, ValueError):
        pass
    return load_codex_from_rollouts(root, since_ms)


